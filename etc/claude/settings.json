{
  "agentPushNotifEnabled" : true,
  "alwaysThinkingEnabled" : true,
  "autoUpdatesChannel" : "stable",
  "effortLevel" : "xhigh",
  "env" : {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING" : "1"
  },
  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "python3 \"${CLAUDE_CONFIG_DIR:-$HOME\/.claude}\/ask_on_delete.py\"",
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      },
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "StopFailure" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "SubagentStop" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "~\/.claude\/hooks\/iterm2.sh \/Users\/paul\/.config\/iterm2\/cc-status",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "minimumVersion" : "2.1.80",
  "model" : "opus[1m]",
  "modelSettings" : {
    "claude-opus-5-5" : {
      "effortLevel" : "xhigh"
    }
  },
  "permissions" : {
    "allow" : [
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(curl:*)",
      "Bash(do echo:*)",
      "Bash(done)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(for i:*)",
      "Bash(g++:*)",
      "Bash(gcc:*)",
      "Bash(git diff *)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(make -C *)",
      "Bash(make:*)",
      "Bash(nproc:*)",
      "Bash(sort -t:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(tee:*)",
      "Bash(xargs ls:*)",
      "Bash(xargs:*)",
      "Read(\/\/tmp\/**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "defaultMode" : "default",
    "deny" : [

    ]
  },
  "respondToBashCommands": false,
  "remoteControlAtStartup" : true,
  "showThinkingSummaries" : true,
  "switchModelsOnFlag" : false,
  "theme" : "dark-ansi",
  "tui" : "fullscreen"
}