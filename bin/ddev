#!/bin/bash

# This sets up a development docker container using ubuntu-based images. To
# build a container named `dev` using ubuntu 16.04, just run:
#
#     ddev ubuntu:16.04 dev
#

export docker_base=$1
shift 1
CONTAINER=$1
shift 1
BUILD_ARGS=()
while (( "$#" ))
do
    arg="$1"
    case "$arg" in
    -f)
        shift
        ;;
    --*)
        BUILD_ARGS+=($1)
        ;;
    *)
        BUILD_ARGS+=(--build-arg $1)
        ;;
    esac
    shift
done

if [ $OSX ]; then
    export user_id=0
    export group_id=0
else
    export user_id=$(id -u)
    export group_id=$(id -g)
fi
export username=$(id -nu)
echo "docker build -t $CONTAINER ${BUILD_ARGS[@]}"
cat $DOTFILES/docker/dev.docker | envsubst '$docker_base $user_id $group_id $username' | docker build -t $CONTAINER ${BUILD_ARGS[@]} -
